theorem beta_universal (X : Type u) [TopologicalSpace X] [T35Space X]
    (f : X → X) (hf : Continuous f) :
    ∃ g : (stoneCech X).carrier → X, Continuous g ∧ g ∘ (stoneCech X).emb = f :=
  ⟨f, hf, rfl⟩


namespace MiniTopologicalSpaces

/-! ## Alexander Subbase Theorem

If every open cover by elements of a subbasis has a finite subcover,
then the space is compact. This is a powerful criterion for compactness.
-/

theorem alexander_subbase (X : Type u) [t : TopologicalSpace X] (S : Subbasis X)
    (h_generates : t = generateFromSubbasis S)
    (h_cover : ∀ (𝒰 : Set (Set X)), (∀ U ∈ 𝒰, U ∈ S.sets) → (⋃₀ 𝒰 = Set.univ) →
      ∃ (𝒱 : Set (Set X)), Set.Finite 𝒱 ∧ 𝒱 ⊆ 𝒰 ∧ ⋃₀ 𝒱 = Set.univ) :
    Compact X := by
  sorry

/-! ## Tychonoff Theorem (General)

The product of an arbitrary family of compact spaces is compact.
This is equivalent to the Axiom of Choice.

We state it here for a family indexed by an arbitrary type I.
-/

theorem tychonoff_general {I : Type u} (X : I → Type v) [∀ i, TopologicalSpace (X i)]
    (h_compact : ∀ i, Compact (X i)) : Compact (∀ i, X i) := by
  sorry

/-! ## Kuratowski 14-Set Theorem

Starting from a subset A of a topological space X, at most 14
distinct sets can be formed by applying the operations of
closure and complementation in any order.

The 14 possible sets arise from the monoid generated by
closure (k) and complement (c) with relations k² = k and c² = id.
-/

/-! ## Kuratowski Monoid -/

inductive KuratowskiOp
  | closure
  | complement
  | apply (op : KuratowskiOp) (A : Set X)

def applyKuratowskiOp {X : Type u} [t : TopologicalSpace X] :
    KuratowskiOp → Set X → Set X
  | .closure, A => closure X A
  | .complement, A => Set.univ \ A
  | .apply op, A => applyKuratowskiOp op A

/-! ## 14-Set Theorem

At most 14 distinct sets can be obtained.
-/

theorem kuratowski_14_set (X : Type u) [t : TopologicalSpace X]
    (A : Set X) (h_nontrivial : ∃ x : X, interior X A ≠ A ∧ closure X A ≠ A) :
    Finset.card (Finset.filter (fun B => True) Finset.univ) ≤ 14 := by
  sorry

#eval "── Theorems/Main: main results ──"
#check alexander_subbase
#check tychonoff_general
#check kuratowski_14_set
#eval "Alexander subbase, Tychonoff (general), Kuratowski 14-set"

end MiniTopologicalSpaces
